from set budget import get_category


def budget_menu():
    budgets = {}
    while True:
        print("\n===== Budget Menu =====")
        print("1. Set new budget")
        print("2. Add or change budget")
        print("3. Show budget")
        print("4. Exit")
        choice = input("Enter your choice: ")

        if choice == "1":
            if len(budgets) > 0:
                answer = input("This replaces your budget. Continue? (y/n): ")
                if answer != "y" and answer != "Y":
                    continue
            new_budget = set_budget()
            if len(new_budget) > 0:
                budgets = new_budget
            else:
                print("Nothing was saved.")
        elif choice == "2":
            if len(budgets) == 0:
                print("Please set a budget first (option 1).")
            else:
                edit_budget(budgets)
        elif choice == "3":
            if len(budgets) == 0:
                print("Please set a budget first (option 1).")
            else:
                show_budget(budgets)
        elif choice == "4":
            print("Thank you for using this program.")
            return budgets
        else:
            print("Please enter a number from 1 to 4.")

budgets = budget_menu()
